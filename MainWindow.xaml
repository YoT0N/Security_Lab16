<Window x:Class="lab16.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система електронного цифрового підпису (ЕЦП)" 
        Height="800" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Секція реєстрації користувачів -->
        <GroupBox Grid.Row="0" Header="Реєстрація користувачів" Margin="0,5,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtUserName" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" 
                         Padding="5" VerticalContentAlignment="Center"
                         FontSize="14"/>

                <Button x:Name="btnRegisterUser" Grid.Row="0" Grid.Column="1" 
                        Content="Зареєструвати" Padding="10,5" Click="btnRegisterUser_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Margin="0,10,0,0" TextWrapping="Wrap" FontStyle="Italic">
                    Примітка: Для кожного користувача буде згенеровано унікальний ідентифікатор та ключ шифрування.
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- Список зареєстрованих користувачів -->
        <GroupBox Grid.Row="1" Header="Зареєстровані користувачі" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="lstUsers" Grid.Column="0" Height="100" 
                         Margin="0,0,5,0" BorderThickness="1" BorderBrush="LightGray"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Відправник (A):" 
                               VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <ComboBox x:Name="cmbSender" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Отримувач (B):" 
                               VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <ComboBox x:Name="cmbReceiver" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Файл:" 
                               VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSelectedFile" Grid.Column="0" IsReadOnly="True" 
                                 VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                        <Button x:Name="btnSelectFile" Grid.Column="1" Content="Вибрати файл" 
                                Padding="5,3" Click="btnSelectFile_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Основна секція процесу ЕЦП та проміжні результати -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Проміжні результати та їх модифікація -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Оригінальне повідомлення -->
                <TextBlock Grid.Row="0" Text="Оригінальне повідомлення:" Margin="0,0,0,5" FontWeight="Bold"/>
                <TextBox x:Name="txtOriginalMessage" Grid.Row="1" Margin="0,0,10,10" 
                         TextWrapping="Wrap" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

                <!-- Зашифроване повідомлення -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Зашифроване повідомлення:" Margin="0,0,0,5" FontWeight="Bold"/>
                    <Button x:Name="btnModifyEncrypted" Grid.Column="1" Content="Модифікувати" 
                            Padding="5,2" Click="btnModifyEncrypted_Click"/>
                </Grid>
                <TextBox x:Name="txtEncryptedMessage" Grid.Row="3" Margin="0,0,10,10" 
                         TextWrapping="Wrap" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

                <!-- Хеш повідомлення -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Хеш повідомлення:" Margin="0,0,0,5" FontWeight="Bold"/>
                    <Button x:Name="btnModifyHash" Grid.Column="1" Content="Модифікувати" 
                            Padding="5,2" Click="btnModifyHash_Click"/>
                </Grid>
                <TextBox x:Name="txtMessageHash" Grid.Row="5" Margin="0,0,10,0" 
                         TextWrapping="Wrap" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </Grid>

            <!-- Контроль етапів підпису -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="Етапи підпису" Padding="10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Крок 1:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStep1Status" Grid.Column="1" Text="Очікується" 
                                   Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="btnStep1" Content="Крок 1: A -> ЦП" Margin="0,0,0,10" 
                            Padding="5" Click="btnStep1_Click"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Крок 2:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStep2Status" Grid.Column="1" Text="Очікується" 
                                   Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="btnStep2" Content="Крок 2: ЦП перевіряє" Margin="0,0,0,10" 
                            Padding="5" Click="btnStep2_Click" IsEnabled="False"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Крок 3:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStep3Status" Grid.Column="1" Text="Очікується" 
                                   Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="btnStep3" Content="Крок 3: ЦП -> B" Margin="0,0,0,10" 
                            Padding="5" Click="btnStep3_Click" IsEnabled="False"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Крок 4:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStep4Status" Grid.Column="1" Text="Очікується" 
                                   Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="btnStep4" Content="Крок 4: B перевіряє" Margin="0,0,0,10" 
                            Padding="5" Click="btnStep4_Click" IsEnabled="False"/>

                    <Button x:Name="btnReset" Content="Скинути" Margin="0,20,0,0" 
                            Padding="5" Click="btnReset_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Статус виконання операцій -->
            <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Статус процесу ЕЦП" Padding="10" Margin="0,5,0,0">
                <TextBox x:Name="txtStatus" TextWrapping="Wrap" IsReadOnly="True" Height="100"
                         VerticalScrollBarVisibility="Auto" FontSize="14" Padding="5"/>
            </GroupBox>
        </Grid>

        <!-- Інформація про процес ЕЦП -->
        <GroupBox Grid.Row="3" Header="Інформація про протокол ЕЦП" Padding="10">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="Bold">Протокол ЕЦП з використанням симетричної криптографії:</Run>
                <LineBreak/>
                <Run>• Крок 1: Сторона A шифрує повідомлення M своїм ключем KA, обчислює хеш H(M) і надсилає ЦП: (IdA, IdB, C=E[KA](M), H(M))</Run>
                <LineBreak/>
                <Run>• Крок 2: ЦП розшифровує C за допомогою ключа KA, обчислює H'(M) і порівнює з отриманим H(M)</Run>
                <LineBreak/>
                <Run>• Крок 3: ЦП зашифровує M ключем KВ отримувача і надсилає стороні B: (IdA, C'=E[KB](M), H(M))</Run>
                <LineBreak/>
                <Run>• Крок 4: Сторона B розшифровує C' своїм ключем KB, обчислює H'(M) і порівнює з отриманим H(M)</Run>
                <LineBreak/>
                <Run>• Якщо хеш-образи співпадають, то ЕЦП підтверджено!</Run>
            </TextBlock>
        </GroupBox>
    </Grid>
</Window>